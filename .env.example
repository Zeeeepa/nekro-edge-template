# ==================================
# Universal Gateway Environment Variables
# ==================================

# ===== API Provider Keys =====
# Get your keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
# - Google Gemini: https://makersuite.google.com/app/apikey

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Claude) API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-key-here

# ===== Browser Automation (Optional) =====
# Browserbase API Key for webchat automation
# Get your key from: https://www.browserbase.com/
BROWSERBASE_API_KEY=your-browserbase-key-here
BROWSERBASE_PROJECT_ID=your-project-id-here

# ===== Database =====
# Cloudflare D1 Database (configured in wrangler.toml)
# No environment variable needed - uses Cloudflare bindings

# ===== Optional Services =====
# FlareProx for proxy providers (optional)
FLAREPROX_API_KEY=your-flareprox-key-here

# ===== Development =====
# Set to 'development' for local dev, 'production' for deployed
NODE_ENV=development

# Enable debug logging
DEBUG=false

# ===== Notes =====
# 1. Copy this file to .env for local development
# 2. Never commit .env to version control
# 3. For Cloudflare Workers deployment, set these in wrangler.toml or via dashboard
# 4. API providers will fall back to simulated mode if keys are missing

